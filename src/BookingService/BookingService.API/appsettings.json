{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "BookingSettings": {
    "MaxBookingsPerUser": 10
  },
  "Jwt": {
    "SecretKey": "very-long-secret--test-key-at-least-32",
    "Issuer": "EventOrchestrationService",
    "Audience": "EventOrchestrationService",
    "ExpiryMinutes": 60
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092"
  },
  "Otlp": {
    "Endpoint": "http://jaeger:4317"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
