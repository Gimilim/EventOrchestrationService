{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "BookingSettings": {
    "MaxBookingsPerUser": 10
  },
  "Jwt": {
    "SecretKey": "very-long-secret--test-key-at-least-32",
    "Issuer": "EventOrchestrationService",
    "Audience": "EventOrchestrationService",
    "ExpiryMinutes": 60
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092"
  },
  "Redis": {
    "Host": "localhost",
    "Port": 6379,
    "ConnectTimeout": 5000,
    "SyncTimeout": 3000,
    "AbortOnConnectFail": false,
    "DefaultCacheTtlMinutes": 5
  }
}
